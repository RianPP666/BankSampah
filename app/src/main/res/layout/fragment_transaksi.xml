<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pencatatan Transaksi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/rgJenisTransaksi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F1F5F9"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbSetor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📥 Setor Sampah"
                android:checked="true"
                android:button="@null"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/black"
                android:background="@drawable/bg_radio_selector" />

            <RadioButton
                android:id="@+id/rbTarik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💰 Tarik Saldo"
                android:button="@null"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/black"
                android:background="@drawable/bg_radio_selector" />
        </RadioGroup>

        <!-- SETOR SECTION -->
        <LinearLayout
            android:id="@+id/layoutSetor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pilih Nasabah"
                android:layout_marginBottom="16dp">

                <AutoCompleteTextView
                    android:id="@+id/spinnerNasabah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/containerItemSampah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnTambahItem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Tambah Sampah Lain"
                android:textSize="14sp"
                android:textColor="#059669"
                android:gravity="center"
                android:background="@drawable/bg_button_outlined"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#ECFDF5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#A7F3D0"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Setoran"
                        android:textSize="14sp"
                        android:textColor="#065F46" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#059669" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSimpanTransaksi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Konfirmasi Setoran"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_primary"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- TARIK SECTION -->
        <LinearLayout
            android:id="@+id/layoutTarik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pilih Nasabah"
                android:layout_marginBottom="16dp">

                <AutoCompleteTextView
                    android:id="@+id/spinnerNasabahTarik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saldo Saat Ini: "
                    android:textSize="14sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/tvSaldoSaatIni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nominal Penarikan (Rp)"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                android:layout_marginBottom="32dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etJumlahTarik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTarikSaldoSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Konfirmasi Penarikan"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_accent"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
